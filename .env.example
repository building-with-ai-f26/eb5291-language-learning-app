# Copy this file to .env and edit that local file only:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

# Paste your private key after = in .env, never in chat or browser code.
OPENROUTER_API_KEY=

# Existing PostHog project token and ingestion host (browser configuration).
VITE_POSTHOG_TOKEN=
VITE_POSTHOG_API_HOST=

# Public Worker origin used to enable the speaker in a Pages build.
VITE_LESSON_AUDIO_ORIGIN=

# Set to true only for a release that includes the fictional replay test.
VITE_POSTHOG_REPLAY_TEST=
