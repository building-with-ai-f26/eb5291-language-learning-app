      "acceptedAnswers": [
        [
          "un",
          "coche",
          "blanco"
        ]
      ],
      "hint": "Start with the Spanish word for “a.” Put the color after coche.",
      "explanation": "Coche is masculine and singular, so “a” is un and “white” is blanco.",
      "mistakeFeedback": [
        {
          "answer": [
            "un",
            "coche",
            "blanca"
          ],
          "feedback": "Coche is masculine. Use blanco to describe it."
        },
        {
          "answer": [
            "una",
            "coche",
            "blanco"
          ],
          "feedback": "Coche is masculine. Use un before it."
        },
        {
          "answer": [
            "un",
            "blanco",
            "coche"
          ],
          "feedback": "For this everyday description, put coche first and follow it with blanco."
        }
      ]
    },
