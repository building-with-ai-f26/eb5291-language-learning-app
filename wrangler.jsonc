{
  "name": "word-of-mouth-speech",
  "main": "worker/lesson-audio.js",
  "compatibility_date": "2026-11-22",
  "secrets": { "required": ["OPENROUTER_API_KEY"] },
  "ratelimits": [
    {
      "name": "SPEECH_VISITORS",
      "namespace_id": "26031177",
      "simple": { "limit": 25, "period": 60 }
    },
    {
      "name": "SPEECH_GENERATIONS",
      "namespace_id": "26031178",
      "simple": { "limit": 12, "period": 60 }
    }
  ]
}
